DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/research_platform

# Document Chunking (recursive | fixed)
# CHUNK_METHOD=recursive
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200

# Search & Reranking
# SEARCH_CANDIDATE_POOL=60
# RRF_K=60
# RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=your_api_key_here

# Extraction & Research Planning
# EXTRACTION_EDGE_CHUNKS=3
# EXTRACTION_SEARCH_LIMIT=5
# MAX_DOCUMENTS_PER_PLAN=15
